# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Never commit real credentials.

# --- Required -------------------------------------------------------------
# Private App access token (HubSpot: Settings > Development > Legacy apps > your app > Auth tab)
HUBSPOT_ACCESS_TOKEN=

# --- Portal ---------------------------------------------------------------
# Your Hub ID (numeric). It appears in every portal URL: https://app.hubspot.com/contacts/<hubId>/...
# The diagnostic script prints it and checks that this value matches the token's account.
HUBSPOT_PORTAL_ID=

# --- Deal defaults --------------------------------------------------------
# Real ids from your portal. Leave empty, run `node src/examples/diagnose.js`,
# and copy the pipeline id and stage id it prints.
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_ID=

# --- HTTP client (optional, defaults shown) --------------------------------
# API base URL (where HTTP calls go; not the portal URL above)
HUBSPOT_BASE_URL=https://api.hubapi.com
# Timeout per request, in milliseconds
HUBSPOT_TIMEOUT_MS=10000
# Retries for 429 / 5xx / network errors (0 disables retries)
HUBSPOT_MAX_RETRIES=3
# Base delay for exponential backoff, in milliseconds
HUBSPOT_RETRY_BASE_DELAY_MS=1000
# Longest single wait accepted from a Retry-After header, in milliseconds. A longer
# Retry-After is honoured by NOT retrying (never earlier than asked) and reporting it.
HUBSPOT_MAX_RETRY_WAIT_MS=120000
# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
